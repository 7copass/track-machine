# ─────────────────────────────────────────────────────────────
#  TRACK MACHINE — variáveis de ambiente
#  Copie para .env e preencha.  O .env NUNCA vai pro git.
# ─────────────────────────────────────────────────────────────

# Token de acesso do Meta.
# Preferência: System User token (Business Manager > Usuários do sistema).
# Alternativa: Graph API Explorer (expira em ~1-2h).
# Permissões necessárias: ads_read, business_management
META_ACCESS_TOKEN=

# ID da conta de anúncio, COM o prefixo act_
# Ex: act_1234567890
META_AD_ACCOUNT_ID=

# Versão da Graph API
META_API_VERSION=v21.0

# Moeda para exibição nos relatórios (a API devolve na moeda da conta)
REPORT_CURRENCY=BRL

# Fuso usado para agregações por dia/hora
TIMEZONE=America/Sao_Paulo
